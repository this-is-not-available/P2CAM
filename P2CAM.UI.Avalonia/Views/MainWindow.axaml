<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:P2CAM.UI.Avalonia.ViewModels"
		xmlns:conv="using:P2CAM.UI.Avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="P2CAM.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
		MinWidth="600" MinHeight="400"
		Width="1024" Height="660"
        Title="P2CAM">

	<Window.Resources>
		<conv:PercentageConverter x:Key="PercentConverter" />
		<conv:FontStepConverter x:Key="FontStepConverter" />
	</Window.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<DockPanel>
		<!-- ToolStrip Area -->
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="{DynamicResource ToolbarBackground}" Spacing="0">
			<Button Content="Install" Background="Transparent" Padding="5" Margin="5" Click="InstallAssetHandler"/>
			<Button Content="Refresh" Background="Transparent" Padding="5" Margin="5" Command="{Binding Refresh}"/>
			<Separator Height="20" Width="3" Margin="5,0"/>
			<!-- <Button Content="Create" Background="Transparent" Padding="5" Margin="5" Command="{Binding CreateHandler}"/> -->
			<Button Content="Options" Background="Transparent" Padding="5" Margin="5" Command="{Binding OpenOptionsHandler}"/>
		</StackPanel>
		
		<Grid x:Name="RootGrid">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*"
					MinHeight="{Binding #RootGrid.Bounds.Height, Converter={StaticResource PercentConverter}, ConverterParameter=0.25}"
					MaxHeight="{Binding #RootGrid.Bounds.Height, Converter={StaticResource PercentConverter}, ConverterParameter=0.5}" />
			</Grid.RowDefinitions>

			<GridSplitter Grid.Row="1" Height="6" Background="Transparent">
				<GridSplitter.Template>
					<ControlTemplate>
						<Panel Margin="8,0">
							<Rectangle Height="6" Fill="{DynamicResource SplitterColor}" VerticalAlignment="Center"/>
							<Border Width="30" Height="4" Background="{DynamicResource SplitterHandleColor}" CornerRadius="2"
									HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Panel>
					</ControlTemplate>
				</GridSplitter.Template>
			</GridSplitter>

			<Grid x:Name="SelectedAssetGrid" ColumnDefinitions="Auto, *">
				<!-- Top-Left: Big Image -->
				<Panel Grid.Column="0" Margin="10"
					   MaxWidth="{Binding #SelectedAssetGrid.Bounds.Width, Converter={StaticResource PercentConverter}, ConverterParameter=0.6}"
					   MinWidth="{Binding #SelectedAssetGrid.Bounds.Width, Converter={StaticResource PercentConverter}, ConverterParameter=0.4}">
					<Image Source="{Binding SelectedImage}"/>
				</Panel>

				<!-- Top-Right: Details -->
				<Panel Grid.Column="1" Margin="10">
					<Grid VerticalAlignment="Stretch"
								RowDefinitions="Auto, *, *">

						<TextBlock x:Name="SelectedName" Grid.Row="0" Text="{Binding SelectedName}" FontSize="{Binding #RootGrid.Bounds.Height, Converter={StaticResource FontStepConverter}, ConverterParameter='500|16|24'}" FontWeight="Bold"/>

						<ScrollViewer Grid.Row="1">
							<TextBlock Text="{Binding SelectedDescription}" FontSize="{Binding #RootGrid.Bounds.Height, Converter={StaticResource FontStepConverter}, ConverterParameter='500|12|14'}" TextWrapping="Wrap"/>
						</ScrollViewer>


						<StackPanel Margin="10" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left">
							<TextBlock Text="{Binding SelectedAuthor}" FontSize="{Binding #RootGrid.Bounds.Height, Converter={StaticResource FontStepConverter}, ConverterParameter='400|8|14'}"/>
							<TextBlock Text="{Binding SelectedCredit}" FontSize="{Binding #RootGrid.Bounds.Height, Converter={StaticResource FontStepConverter}, ConverterParameter='400|8|14'}"/>
							<TextBlock Text="{Binding SelectedVersion}" FontSize="{Binding #RootGrid.Bounds.Height, Converter={StaticResource FontStepConverter}, ConverterParameter='400|8|14'}"/>

							<!-- Buttons for selected asset-->
							<StackPanel>
								<Button Command="{Binding UninstallAsset}" Margin="0, 10" FontSize="{Binding #RootGrid.Bounds.Height, Converter={StaticResource FontStepConverter}, ConverterParameter='500|12|14'}">
									Uninstall
								</Button>
							</StackPanel>
						</StackPanel>
					</Grid>
				</Panel>
			</Grid>

			<!-- Horizontal Scroll Area -->
			<ScrollViewer Grid.Row="2" Grid.Column="0"
							HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Disabled"
							VerticalAlignment="Stretch"
							Margin="10">
				<ItemsControl ItemsSource="{Binding Items}">
					<!-- This tells the ItemsControl to lay out its items horizontally -->
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0" Padding="0" BorderBrush="Gray" BorderThickness="1" Background="Transparent">
								<Viewbox Stretch="Uniform" VerticalAlignment="Stretch">
									<Button Command="{Binding $parent[ItemsControl].DataContext.AssetClickHandler}"
											CommandParameter="{Binding Id}"
											Padding="10"
											Background="Transparent">

										<StackPanel Orientation="Vertical" Spacing="10">
											<Image Source="{Binding Image}"
												   Width="392"
												   Height="216"
												   Stretch="Uniform" />

											<StackPanel>
												<TextBlock Text="{Binding Title}"
														   FontWeight="Bold"
														   FontSize="16"/>
											</StackPanel>
										</StackPanel>
									</Button>
								</Viewbox>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</DockPanel>
</Window>
